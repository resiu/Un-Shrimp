// Only used by `npm run typecheck` and your editor. Node runs the .ts files directly
// (it just strips the types), so nothing here affects how the server runs.
{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["ES2023"],
    "types": ["node"],
    "module": "nodenext",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    // Blocks syntax Node can't strip (enums, namespaces, parameter properties).
    "erasableSyntaxOnly": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["src"]
}
