# Copy this file to .env (same folder) and change the secret.
# The secret signs login tokens. Anyone who knows it can log in as anyone.
JWT_SECRET=change-me-to-a-long-random-string
PORT=3001

# Voice-over roasts (optional). Get a key at https://elevenlabs.io (Profile -> API Keys).
# Leave it empty and the roasts use the browser's built-in voice instead.
ELEVENLABS_API_KEY=
# Optional: any voice ID from your ElevenLabs Voice Library. Empty = default voice.
ELEVENLABS_VOICE_ID=
